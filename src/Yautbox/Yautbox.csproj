<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Yautbox</Title>
    <PackageTags>outbox yautbox</PackageTags>
    <Description>Lightweight .NET outbox library for enqueueing messages during application work and processing them later with background handlers. Storage-agnostic core with pluggable providers (InMemory, MSSQL, Postgres).</Description>
    <PackageProjectUrl>https://github.com/maximiliysiss/yautbox/tree/master/src/Yautbox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maximiliysiss/yautbox/tree/master/src/Yautbox</RepositoryUrl>
    <PackageId>Yautbox</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <PackageReference Include="Polly"/>
    <PackageReference Include="Scrutor"/>
    <PackageReference Include="StronglyTypedId"/>
    <PackageReference Include="System.Linq.Async"/>
  </ItemGroup>
</Project>
